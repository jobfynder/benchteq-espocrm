{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "sessionDate": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "notes": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "servicePackage": {
            "type": "link"
        },
        "status": {
            "type": "enum",
            "options": [
                "Scheduled",
                "Completed",
                "Cancelled",
                "Rescheduled",
                "No-Show"
            ],
            "style": {},
            "default": "Scheduled",
            "maxLength": 100,
            "isCustom": true
        },
        "sessionDuration": {
            "type": "enum",
            "options": ["30 mins", "45 mins", "1 hour"],
            "maxLength": 100,
            "isCustom": true
        },
        "deliveryResource": {
            "type": "link"
        },
        "payouts": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "deliveryResource": {
            "type": "belongsTo",
            "foreign": "sessionLogs",
            "entity": "CDeliveryResource",
            "audited": false,
            "isCustom": true
        },
        "servicePackage": {
            "type": "belongsTo",
            "foreign": "sessionLogs",
            "entity": "CServicePackage",
            "audited": false,
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "relationName": "cPayoutCSessionLog",
            "foreign": "sessionLogs",
            "entity": "CPayout",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
