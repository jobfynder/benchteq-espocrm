{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "technology": {
            "type": "enum",
            "audited": true,
            "isCustom": true,
            "options": [
                "Java",
                ".NET",
                "Python",
                "JavaScript",
                "React",
                "Angular",
                "Node.js",
                "SQL",
                "AWS",
                "Azure",
                "DevOps",
                "Data Engineering",
                "Salesforce",
                "SAP",
                "QA Testing",
                "Other"
            ],
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutDetailSmallDisabled": true,
            "layoutListSmallDisabled": true
        },
        "technologyRef": {
            "type": "link",
            "required": true,
            "audited": true,
            "isCustom": true
        },
        "skillSets": {
            "type": "linkMultiple",
            "isCustom": true
        },
        "jobTitle": {
            "type": "varchar",
            "maxLength": 150,
            "audited": true,
            "isCustom": true
        },
        "consultant": {
            "type": "link",
            "required": true
        },
        "account": {
            "type": "link"
        },
        "freelancer": {
            "type": "link",
            "view": "custom:views/fields/shortlist-freelancer",
            "audited": true
        },
        "customerRate": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "freelancerPayType": {
            "type": "enum",
            "options": [
                "Hourly",
                "Bi-Weekly",
                "Monthly"
            ],
            "default": "Hourly",
            "maxLength": 100,
            "isCustom": true
        },
        "freelancerRate": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "startDate": {
            "type": "date",
            "isCustom": true
        },
        "scheduleNotes": {
            "type": "text",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "On Hold",
                "Completed"
            ],
            "default": "Active",
            "style": {
                "Completed": "success",
                "On Hold": "warning"
            },
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "paymentBlocks": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "customerRateCurrency": {
            "default": "USD"
        },
        "freelancerRateCurrency": {
            "default": "INR"
        },
        "payouts": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "timesheets": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "marginPerHour": {
            "type": "currency",
            "conversionDisabled": true,
            "readOnly": true,
            "isCustom": true
        },
        "margin": {
            "type": "currency",
            "conversionDisabled": true,
            "readOnly": true,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "consultant": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cProjects",
            "audited": false,
            "isCustom": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "cProjects",
            "audited": false,
            "isCustom": true
        },
        "freelancer": {
            "type": "belongsTo",
            "entity": "CDeliveryResource",
            "foreign": "projects",
            "audited": false,
            "isCustom": true
        },
        "paymentBlocks": {
            "type": "hasMany",
            "entity": "CPaymentBlock",
            "foreign": "project",
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "entity": "CPayout",
            "foreign": "project",
            "isCustom": true
        },
        "timesheets": {
            "type": "hasMany",
            "entity": "CTimesheet",
            "foreign": "project",
            "isCustom": true
        },
        "technologyRef": {
            "type": "belongsTo",
            "entity": "CTechnology",
            "foreign": "projects",
            "audited": false,
            "isCustom": true
        },
        "skillSets": {
            "type": "hasMany",
            "entity": "CTechnology",
            "relationName": "cProjectSkillSet",
            "isCustom": true,
            "foreign": "skillProjects"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "jobTitle",
            "technologyRef.name",
            "skillSets.name"
        ]
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
