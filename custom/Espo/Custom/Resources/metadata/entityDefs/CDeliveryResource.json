{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "roleType": {
            "type": "enum",
            "required": true,
            "options": [
                "Trainer",
                "Freelancer",
                "Interview Supporter"
            ],
            "style": [],
            "default": "Interview Supporter",
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "sourcedVia": {
            "type": "enum",
            "options": [
                "Direct",
                "Via Provider"
            ],
            "style": [],
            "default": "Direct",
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "skillSpecialty": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "rate": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "rateCurrency": {
            "default": "INR"
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive",
                "On Leave"
            ],
            "style": [],
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "provider": {
            "type": "link"
        },
        "referrer": {
            "type": "link"
        },
        "phone": {
            "type": "phone",
            "typeList": [
                "Mobile",
                "WhatsApp",
                "Office",
                "Other"
            ],
            "defaultType": "Mobile",
            "isCustom": true
        },
        "sessionLogs": {
            "type": "linkMultiple"
        },
        "payouts": {
            "type": "link"
        },
        "technologies": {
            "type": "multiEnum",
            "options": [
                "Java",
                ".NET",
                "Python",
                "JavaScript",
                "React",
                "Angular",
                "Node.js",
                "SQL",
                "AWS",
                "Azure",
                "DevOps",
                "Data Engineering",
                "Salesforce",
                "SAP",
                "QA Testing",
                "Other"
            ],
            "storeArrayValues": true,
            "default": [],
            "isCustom": true
        },
        "screeningResult": {
            "type": "enum",
            "options": [
                "Pending",
                "Passed",
                "Failed"
            ],
            "default": "Pending",
            "style": {
                "Passed": "success",
                "Failed": "danger"
            },
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "rating": {
            "type": "int",
            "min": 1,
            "max": 5,
            "isCustom": true
        },
        "screeningNotes": {
            "type": "text",
            "isCustom": true
        },
        "workStatus": {
            "type": "enum",
            "options": [
                "Available",
                "On Project",
                "Inactive"
            ],
            "default": "Available",
            "maxLength": 100,
            "isCustom": true
        },
        "email": {
            "type": "email",
            "isCustom": true
        },
        "projects": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "timesheets": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "interviewSessions": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "provider": {
            "type": "belongsTo",
            "foreign": "deliveryResources",
            "entity": "CProvider",
            "audited": false,
            "isCustom": true
        },
        "referrer": {
            "type": "belongsTo",
            "foreign": "deliveryResources",
            "entity": "CReferrer",
            "audited": false,
            "isCustom": true
        },
        "sessionLogs": {
            "type": "hasMany",
            "foreign": "deliveryResource",
            "entity": "CSessionLog",
            "audited": false,
            "isCustom": true
        },
        "primaryDeliveryResource": {
            "type": "hasMany",
            "foreign": "servicePackagesPrimary",
            "entity": "CServicePackage",
            "audited": false,
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "foreign": "deliveryResource",
            "entity": "CPayout",
            "isCustom": true
        },
        "projects": {
            "type": "hasMany",
            "entity": "CProject",
            "foreign": "freelancer",
            "isCustom": true
        },
        "timesheets": {
            "type": "hasMany",
            "entity": "CTimesheet",
            "foreign": "freelancer",
            "isCustom": true
        },
        "interviewSessions": {
            "type": "hasMany",
            "entity": "CInterviewSession",
            "foreign": "freelancer",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
