{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "roleType": {
            "type": "enum",
            "required": true,
            "options": [
                "Trainer",
                "Freelancer",
                "Interview Supporter"
            ],
            "style": [],
            "default": "Interview Supporter",
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "sourcedVia": {
            "type": "enum",
            "options": [
                "Direct",
                "Via Provider"
            ],
            "style": [],
            "default": "Direct",
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "skillSpecialty": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "rate": {
            "type": "currency",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive",
                "On Leave"
            ],
            "style": [],
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "provider": {
            "type": "link"
        },
        "referrer": {
            "type": "link"
        },
        "phone": {
            "type": "phone",
            "isCustom": true
        },
        "sessionLogs": {
            "type": "linkMultiple"
        },
        "payouts": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "provider": {
            "type": "belongsTo",
            "foreign": "deliveryResources",
            "entity": "CProvider",
            "audited": false,
            "isCustom": true
        },
        "referrer": {
            "type": "belongsTo",
            "foreign": "deliveryResources",
            "entity": "CReferrer",
            "audited": false,
            "isCustom": true
        },
        "sessionLogs": {
            "type": "hasMany",
            "foreign": "deliveryResource",
            "entity": "CSessionLog",
            "audited": false,
            "isCustom": true
        },
        "primaryDeliveryResource": {
            "type": "hasMany",
            "foreign": "servicePackagesPrimary",
            "entity": "CServicePackage",
            "audited": false,
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "foreign": "deliveryResource",
            "entity": "CPayout",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
