{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "bgcType": {
            "type": "enum",
            "options": [
                "US",
                "India",
                "Both"
            ],
            "required": true,
            "maxLength": 100,
            "isCustom": true
        },
        "bgcStatus": {
            "type": "enum",
            "options": [
                "Not Started",
                "In Verification",
                "Cleared",
                "Failed"
            ],
            "default": "Not Started",
            "style": {
                "Cleared": "success",
                "Failed": "danger",
                "In Verification": "warning"
            },
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "customerFee": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "customerFeeCurrency": {
            "default": "USD"
        },
        "amountReceived": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "amountReceivedCurrency": {
            "default": "USD"
        },
        "provider": {
            "type": "link"
        },
        "providerCost": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "providerCostCurrency": {
            "default": "INR"
        },
        "referrer": {
            "type": "link"
        },
        "referralPaid": {
            "type": "bool",
            "readOnly": true,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cBgcChecks",
            "audited": false,
            "isCustom": true
        },
        "provider": {
            "type": "belongsTo",
            "entity": "CProvider",
            "foreign": "bgcChecks",
            "isCustom": true
        },
        "referrer": {
            "type": "belongsTo",
            "entity": "CReferrer",
            "foreign": "bgcChecks",
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "entity": "CPayout",
            "foreign": "bgcCheck",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
