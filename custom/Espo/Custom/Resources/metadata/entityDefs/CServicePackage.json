{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "serviceType": {
            "type": "enum",
            "options": [
                "Interview Support",
                "Job Support",
                "BGC"
            ],
            "style": [],
            "default": "Interview Support",
            "maxLength": 100,
            "isCustom": true
        },
        "sessionsTotal": {
            "type": "int",
            "isCustom": true
        },
        "sessionsRemaining": {
            "type": "int",
            "isCustom": true
        },
        "startDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Completed",
                "Expired"
            ],
            "style": [],
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "packagePrice": {
            "type": "currency",
            "isCustom": true
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Pending",
                "Partially Paid",
                "Paid",
                "Overdue"
            ],
            "style": [],
            "default": "Pending",
            "maxLength": 100,
            "isCustom": true
        },
        "amountPaid": {
            "type": "currency",
            "isCustom": true
        },
        "outstandingBalance": {
            "type": "currency",
            "readOnly": true,
            "isCustom": true
        },
        "bgcVerificationType": {
            "type": "enum",
            "options": ["US", "India", "Both"],
            "maxLength": 100,
            "isCustom": true
        },
        "payoutFrequency": {
            "type": "enum",
            "options": ["Per Session", "Weekly", "Bi-Weekly", "Monthly"],
            "maxLength": 100,
            "isCustom": true
        },
        "renewalDueDate": {
            "type": "date",
            "isCustom": true
        },
        "referrer": {
            "type": "link"
        },
        "primaryDeliveryResource": {
            "type": "link"
        },
        "account": {
            "type": "link"
        },
        "contact": {
            "type": "link"
        },
        "fulfillingProvider": {
            "type": "link"
        },
        "opportunity": {
            "type": "link"
        },
        "payouts": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "referrer": {
            "type": "belongsTo",
            "foreign": "servicePackages",
            "entity": "CReferrer",
            "audited": false,
            "isCustom": true
        },
        "primaryDeliveryResource": {
            "type": "belongsTo",
            "foreign": "primaryDeliveryResource",
            "entity": "CDeliveryResource",
            "audited": false,
            "isCustom": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cServicePackages",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "cServicePackages",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        },
        "sessionLogs": {
            "type": "hasMany",
            "foreign": "servicePackage",
            "entity": "CSessionLog",
            "audited": false,
            "isCustom": true
        },
        "fulfillingProvider": {
            "type": "belongsTo",
            "foreign": "servicePackages",
            "entity": "CProvider",
            "isCustom": true
        },
        "opportunity": {
            "type": "belongsTo",
            "foreign": "servicePackages",
            "entity": "Opportunity",
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "foreign": "servicePackage",
            "entity": "CPayout",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
