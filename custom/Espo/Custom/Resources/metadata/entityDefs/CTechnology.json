{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "freelancers": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "projects": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "skills": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "skillProjects": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true
        },
        "skillFreelancers": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "freelancers": {
            "type": "hasMany",
            "entity": "CDeliveryResource",
            "foreign": "techList",
            "relationName": "cDeliveryResourceCTechnology",
            "isCustom": true
        },
        "projects": {
            "type": "hasMany",
            "entity": "CProject",
            "foreign": "technologyRef",
            "isCustom": true
        },
        "skills": {
            "type": "hasMany",
            "entity": "CSkill",
            "foreign": "technology",
            "isCustom": true
        },
        "skillProjects": {
            "type": "hasMany",
            "entity": "CProject",
            "foreign": "skillSets",
            "relationName": "cProjectSkillSet",
            "layoutRelationshipsDisabled": true,
            "isCustom": true
        },
        "skillFreelancers": {
            "type": "hasMany",
            "entity": "CDeliveryResource",
            "foreign": "skillSets",
            "relationName": "cDeliveryResourceSkillSet",
            "layoutRelationshipsDisabled": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        }
    }
}
