{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "referrerType": {
            "type": "enum",
            "options": [
                "Existing Consultant",
                "Staffing Agency",
                "Trainer",
                "Provider",
                "External Contact"
            ],
            "style": [],
            "default": "Existing Consultant",
            "maxLength": 100,
            "isCustom": true
        },
        "referralFee": {
            "type": "currency",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive"
            ],
            "style": [],
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "phone": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "leads": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "payouts": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        },
        "whatsAppNumber": {
            "type": "varchar",
            "maxLength": 50,
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "accounts": {
            "type": "hasMany",
            "relationName": "cReferrerAccount",
            "foreign": "cReferrers",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "deliveryResources": {
            "type": "hasMany",
            "foreign": "referrer",
            "entity": "CDeliveryResource",
            "audited": false,
            "isCustom": true
        },
        "providers": {
            "type": "hasMany",
            "foreign": "referrer",
            "entity": "CProvider",
            "audited": false,
            "isCustom": true
        },
        "servicePackages": {
            "type": "hasMany",
            "foreign": "referrer",
            "entity": "CServicePackage",
            "audited": false,
            "isCustom": true
        },
        "contacts": {
            "type": "hasMany",
            "relationName": "cReferrerContact",
            "foreign": "cReferrers",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        },
        "opportunities": {
            "type": "hasMany",
            "foreign": "referrer",
            "entity": "Opportunity",
            "isCustom": true
        },
        "leads": {
            "type": "hasMany",
            "entity": "Lead",
            "foreign": "referrer",
            "isCustom": true
        },
        "payouts": {
            "type": "hasMany",
            "entity": "CPayout",
            "foreign": "referrer",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
