{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "project": {
            "type": "link",
            "required": true
        },
        "startDate": {
            "type": "date",
            "isCustom": true
        },
        "amount": {
            "type": "currency",
            "conversionDisabled": true,
            "isCustom": true
        },
        "amountCurrency": {
            "default": "USD"
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Pending",
                "Paid"
            ],
            "default": "Pending",
            "style": {
                "Paid": "success",
                "Pending": "warning"
            },
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "paidDate": {
            "type": "date",
            "isCustom": true
        },
        "totalHrs": {
            "type": "float",
            "required": true,
            "min": 0,
            "decimalPlaces": 2,
            "isCustom": true
        },
        "connectedHrs": {
            "type": "float",
            "readOnly": true,
            "default": 0,
            "decimalPlaces": 2,
            "isCustom": true
        },
        "remainingHrs": {
            "type": "float",
            "readOnly": true,
            "decimalPlaces": 2,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Completed"
            ],
            "default": "Active",
            "style": {
                "Completed": "success"
            },
            "maxLength": 100,
            "isCustom": true
        },
        "timesheets": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "project": {
            "type": "belongsTo",
            "entity": "CProject",
            "foreign": "paymentBlocks",
            "audited": false,
            "isCustom": true
        },
        "timesheets": {
            "type": "hasMany",
            "entity": "CTimesheet",
            "foreign": "paymentBlock",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
