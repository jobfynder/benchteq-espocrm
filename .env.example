# Copy to .env and replace every CHANGE_ME value before starting.
COMPOSE_PROJECT_NAME=benchteq-crm
ESPOCRM_IMAGE=espocrm/espocrm:10
MARIADB_IMAGE=mariadb:11.8

ESPOCRM_PORT=8080
ESPOCRM_WEBSOCKET_PORT=8081
ESPOCRM_SITE_URL=http://localhost:8080
ESPOCRM_WEBSOCKET_URL=ws://localhost:8081

ESPOCRM_ADMIN_USERNAME=benchteq-admin
ESPOCRM_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

ESPOCRM_LANGUAGE=en_US
ESPOCRM_TIME_ZONE=America/New_York
ESPOCRM_DEFAULT_CURRENCY=USD

